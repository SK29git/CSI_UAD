{
  "rewrites": [
    {
      "source": "/api/service/:path*",
      "destination": "https://mt-otolink-api-stage.otolink.app/api/service/:path*"
    },
    {
      "source": "/api/service-locations/:path*",
      "destination": "https://mt-otolink-api-stage.otolink.app/api/service-locations/:path*"
    },
    {
      "source": "/api/leads/generate-token/:path*",
      "destination": "https://mt-otolink-api-stage.otolink.app/api/leads/generate-token/:path*"
    },
    {
      "source": "/otolink-api/:path*",
      "destination": "https://mt-otolink-api-stage.otolink.app/:path*"
    },
    {
      "source": "/sms-gateway/:path*",
      "destination": "https://agmcutil.agmcgroup.ae/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ccaas.agmcgroup.ae/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
