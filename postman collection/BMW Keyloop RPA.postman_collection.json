  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Requested times must be in the future and inside working hours, so blank dates roll forward.",
          "function day(offset) { const d = new Date(); d.setDate(d.getDate() + offset); return d.toISOString().slice(0, 10); }",
          "const demo = pm.collectionVariables.get('demoDate') || day(1);",
          "const resched = pm.collectionVariables.get('rescheduleDate') || day(2);",
          "const appt = pm.collectionVariables.get('appointmentDate') || day(1);",
          "pm.collectionVariables.set('resolvedDemoStartAt', demo + 'T' + pm.collectionVariables.get('demoTimeFrom'));",
          "pm.collectionVariables.set('resolvedDemoEndAt', demo + 'T' + pm.collectionVariables.get('demoTimeTo'));",
          "pm.collectionVariables.set('resolvedRescheduleStartAt', resched + 'T' + pm.collectionVariables.get('rescheduleTimeFrom'));",
          "pm.collectionVariables.set('resolvedRescheduleEndAt', resched + 'T' + pm.collectionVariables.get('rescheduleTimeTo'));",
          "pm.collectionVariables.set('resolvedAppointmentAt', appt + 'T' + pm.collectionVariables.get('appointmentTime'));"
        ]
      }
    }
  ],
